@model DACS.Models.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3">
                            <i class="fa-solid fa-gear text-primary fs-4"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Cài đặt hệ thống</h4>
                            <p class="text-muted small mb-0">Tùy chỉnh cấu hình vận hành và giao diện</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Settings" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>
                        <!-- Mục 1: Cảnh báo -->
                        <div class="mb-5">
                            <h5 class="fw-bold mb-3 d-flex align-items-center">
                                <i class="fa-solid fa-bell text-warning me-2"></i> Thông báo & Cảnh báo
                            </h5>
                            <div class="bg-light p-4 rounded-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div>
                                        <h6 class="mb-1 fw-semibold">Nhận thông báo hệ thống</h6>
                                        <p class="text-muted small mb-0">Bật/tắt thông báo đẩy khi có sự kiện (quá tốc độ, ngoại lệ...)</p>
                                    </div>
                                    <div class="form-check form-switch fs-4">
                                        <input asp-for="IsNotificationEnabled" class="form-check-input custom-switch" type="checkbox" onchange="this.form.submit()">
                                    </div>
                                </div>
                                <hr class="opacity-10">
                                <div class="row align-items-center">
                                    <div class="col-md-7">
                                        <h6 class="mb-1 fw-semibold">Ngưỡng tốc độ giới hạn (km/h)</h6>
                                        <p class="text-muted small mb-0">Hệ thống sẽ gửi cảnh báo nếu xe vượt quá mức này</p>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="input-group">
                                            <input asp-for="SpeedLimitThreshold" class="form-control border-end-0" type="number" step="0.1" />
                                            <span class="input-group-text bg-white border-start-0 text-muted">km/h</span>
                                        </div>
                                        <span asp-validation-for="SpeedLimitThreshold" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mb-5">
                            <a asp-action="Profile" class="btn btn-light px-4 py-2 rounded-3 fw-semibold">Hủy</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 fw-semibold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Lưu cài đặt
                            </button>
                        </div>
                    </form>

                    <hr class="my-5 opacity-10">

                    <!-- Mục 2: Quản lý dữ liệu -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3 d-flex align-items-center text-danger">
                                <i class="fa-solid fa-database me-2"></i> Quản lý dữ liệu
                            </h5>
                            
                            <!-- Xóa Lịch sử -->
                            <div class="border border-danger border-opacity-10 p-4 rounded-4 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 fw-semibold text-danger">Xóa sạch lịch sử GPS</h6>
                                        <p class="text-muted small mb-0">Xóa vĩnh viễn toàn bộ dữ liệu di chuyển của tất cả xe.</p>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm px-4" data-bs-toggle="modal" data-bs-target="#clearHistoryModal">
                                        <i class="fa-solid fa-route me-2"></i> Xóa lịch sử
                                    </button>
                                </div>
                            </div>

                            <!-- Xóa Cảnh báo -->
                            <div class="border border-danger border-opacity-10 p-4 rounded-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 fw-semibold text-danger">Xóa danh sách Cảnh báo</h6>
                                        <p class="text-muted small mb-0">Xóa vĩnh viễn toàn bộ các thông báo cảnh báo hệ thống.</p>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm px-4" data-bs-toggle="modal" data-bs-target="#clearAlertsModal">
                                        <i class="fa-solid fa-bell me-2"></i> Xóa cảnh báo
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Modal xác nhận xóa Lịch sử -->
                        <div class="modal fade" id="clearHistoryModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <div class="modal-header border-0 pt-4 px-4">
                                        <h5 class="modal-title fw-bold text-danger">Xác nhận xóa lịch sử</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <p class="mb-0">Duy có chắc chắn muốn xóa toàn bộ **Lịch sử GPS** không? Hành động này không thể hoàn tác.</p>
                                    </div>
                                    <div class="modal-footer border-0 pb-4 px-4">
                                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                                        <form asp-action="ClearGpsHistory" method="post">
                                            <button type="submit" class="btn btn-danger px-4 shadow-sm">Có, tôi chắc chắn</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modal xác nhận xóa Cảnh báo -->
                        <div class="modal fade" id="clearAlertsModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <div class="modal-header border-0 pt-4 px-4">
                                        <h5 class="modal-title fw-bold text-danger">Xác nhận xóa cảnh báo</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <p class="mb-0">Duy có chắc chắn muốn xóa toàn bộ **Danh sách Cảnh báo** không? Hành động này không thể hoàn tác.</p>
                                    </div>
                                    <div class="modal-footer border-0 pb-4 px-4">
                                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                                        <form asp-action="ClearAlerts" method="post">
                                            <button type="submit" class="btn btn-danger px-4 shadow-sm">Có, tôi chắc chắn</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-switch:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
    .btn-check:checked + .btn-outline-primary {
        background-color: rgba(13, 110, 253, 0.1);
        border-color: #0d6efd;
        color: #0d6efd;
        font-weight: bold;
    }
</style>
