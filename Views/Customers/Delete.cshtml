@model DACS.Models.Customer

@{
    ViewData["Title"] = "Xóa Khách hàng";
}

<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center mt-5">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 text-center p-4">
                <div class="mb-4">
                    <div class="display-3 text-danger mb-3"><i class="fa-solid fa-user-xmark"></i></div>
                    <h2 class="fw-bold">Xác nhận xóa?</h2>
                    <p class="text-muted">Bạn có chắc chắn muốn xóa khách hàng <strong>@Model.Name</strong>? Hành động này không thể hoàn tác.</p>
                </div>
                
                <div class="bg-light p-4 rounded-4 text-start mb-4">
                    <div class="row g-3">
                        <div class="col-6 small text-muted">Số điện thoại:</div>
                        <div class="col-6 fw-bold text-dark">@Model.Phone</div>
                        <div class="col-6 small text-muted">Tỉn định danh (CCCD):</div>
                        <div class="col-6 fw-bold text-dark">@(Model.CitizenID ?? "Chưa có")</div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-center">
                        <a asp-action="Index" class="btn btn-light px-5 py-2 fw-semibold">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger px-5 py-2 fw-semibold shadow-sm">
                            <i class="fa-solid fa-trash me-2"></i>Xóa vĩnh viễn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
