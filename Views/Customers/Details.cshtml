@model DACS.Models.Customer

@{
    ViewData["Title"] = "Chi tiết Khách hàng";
}

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Khách hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="fw-bold text-dark">Hồ sơ: @Model.Name</h2>
            <div class="btn-group shadow-sm">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-success px-4"><i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa</a>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Thông tin cá nhân -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">
                    <div class="avatar-lg bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px;">
                        <span class="text-primary fw-bold display-4">@(Model.Name.Substring(0, 1).ToUpper())</span>
                    </div>
                    <h4 class="fw-bold mb-1">@Model.Name</h4>
                    <p class="text-muted mb-4 small">Khách hàng từ @Model.CreatedDate.Year</p>
                    
                    <hr>
                    
                    <div class="text-start">
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Số điện thoại</label>
                            <div class="fw-semibold">@Model.Phone</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Email</label>
                            <div class="fw-semibold text-break">@Model.Email</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Địa chỉ</label>
                            <div class="fw-semibold">@Model.Address</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Ngày sinh</label>
                            <div class="fw-semibold">@(Model.Birthday?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small fw-bold text-uppercase">Số CCCD</label>
                            <div class="fw-semibold">@(Model.CitizenID ?? "N/A")</div>
                        </div>
                        <div>
                            <label class="text-muted small fw-bold text-uppercase">Bằng lái xe</label>
                            <div class="fw-semibold">@(Model.DriverLicense ?? "N/A")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lịch sử thuê xe -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-0">Lịch sử thuê xe gần đây</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Xe</th>
                                    <th>Thời gian</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rental in Model.Rentals.OrderByDescending(r => r.StartDate))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@rental.Vehicle.Name</div>
                                            <div class="text-muted small text-primary fw-medium">@rental.Vehicle.LicensePlate</div>
                                        </td>
                                        <td>
                                            <div class="small">Từ: @rental.StartDate.ToString("dd/MM/yyyy")</div>
                                            <div class="small text-muted">Đến: @rental.EndDate.ToString("dd/MM/yyyy")</div>
                                        </td>
                                        <td>
                                            @if (rental.Status == "Active")
                                            {
                                                <span class="badge bg-success-subtle text-success px-2 py-1">Đang thuê</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Đã trả</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="#" class="btn btn-light btn-sm"><i class="fa-solid fa-file-contract"></i> Xem HĐ</a>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Rentals.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5">
                                            <p class="text-muted mb-0">Khách hàng này chưa có lịch sử thuê xe nào.</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.1); }
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1); }
    .bg-secondary-subtle { background-color: rgba(108, 117, 125, 0.1); }
</style>
