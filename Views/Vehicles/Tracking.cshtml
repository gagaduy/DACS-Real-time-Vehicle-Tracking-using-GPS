@model DACS.Models.Vehicle

@{
    ViewData["Title"] = "Theo dõi xe: " + Model.Name;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div class="container-fluid px-4 py-4">
    <div class="row g-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> Thông tin xe</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold">Tên xe</label>
                        <div class="fw-bold fs-5 text-truncate">@Model.Name</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold">Biển số</label>
                        <div><span class="badge bg-light text-dark border px-3 py-2">@Model.LicensePlate</span></div>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold">Vị trí hiện tại</label>
                        <div id="lat-display" class="small">Vĩ độ: @(Model.LastLatitude?.ToString("F6") ?? "N/A")</div>
                        <div id="lng-display" class="small">Kinh độ: @(Model.LastLongitude?.ToString("F6") ?? "N/A")</div>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold">Vận tốc</label>
                        <div id="speed-display" class="fs-4 fw-bold text-primary">0 <span class="fs-6 fw-normal">km/h</span></div>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small text-uppercase fw-bold">Cập nhật lúc</label>
                        <div id="time-display" class="small text-muted">@(Model.LastUpdated?.ToString("HH:mm:ss dd/MM/yyyy") ?? "Chưa có dữ liệu")</div>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Quay lại danh sách</a>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div id="map" style="height: 600px;" class="rounded shadow-sm border"></div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    var map, marker;
    var vehicleId = @Model.Id;
    var lastLat = @(Model.LastLatitude ?? 10.762622); // Default HCM
    var lastLng = @(Model.LastLongitude ?? 106.660172);

    document.addEventListener('DOMContentLoaded', function () {
        // Initialize Map
        map = L.map('map').setView([lastLat, lastLng], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        // Custom Icon
        var carIcon = L.icon({
            iconUrl: 'https://cdn-icons-png.flaticon.com/512/744/744465.png',
            iconSize: [40, 40],
            iconAnchor: [20, 20],
            popupAnchor: [0, -20]
        });

        marker = L.marker([lastLat, lastLng], { icon: carIcon }).addTo(map)
            .bindPopup("<strong>@Model.Name</strong><br>@Model.LicensePlate")
            .openPopup();

        // Polling Logic
        setInterval(updatePosition, 5000);
    });

    function updatePosition() {
        fetch('/api/gps/' + vehicleId)
            .then(response => response.json())
            .then(data => {
                if (data.lastLatitude && data.lastLongitude) {
                    var newPos = [data.lastLatitude, data.lastLongitude];
                    
                    // Update Marker
                    marker.setLatLng(newPos);
                    map.panTo(newPos);

                    // Update UI Info
                    document.getElementById('lat-display').innerText = "Vĩ độ: " + data.lastLatitude.toFixed(6);
                    document.getElementById('lng-display').innerText = "Kinh độ: " + data.lastLongitude.toFixed(6);
                    document.getElementById('speed-display').innerHTML = data.latestSpeed.toFixed(1) + ' <span class="fs-6 fw-normal">km/h</span>';
                    
                    if (data.lastUpdated) {
                        var date = new Date(data.lastUpdated);
                        document.getElementById('time-display').innerText = date.toLocaleString('vi-VN');
                    }
                }
            })
            .catch(error => console.error('Error fetching GPS data:', error));
    }
</script>
